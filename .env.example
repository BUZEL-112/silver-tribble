# Database Configuration (Docker local, Supabase, or Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_news_video
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_news_video

# LiteLLM Proxy Configuration
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-litellm-master-key

# AI Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Asset Storage (local or s3/r2)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/assets

# Cloudflare R2 / S3 Storage (Required only if STORAGE_BACKEND=s3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Speech to Text Alignment
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu

# Optional Stock Footage API (Phase 3)
PEXELS_API_KEY=
